{
    "compilerOptions": {
      "target": "ES2020",
      "lib": ["ES2020", "DOM"],
      "module": "commonjs",
      "strict": true,
      "esModuleInterop": true,
      "rootDir": ".",
      "outDir": "./dist",
      "moduleResolution": "Node",
      "resolveJsonModule": true,
      "isolatedModules": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "tests"]
  }
  